# APP
PORT=4000
JWT_SECRET=superSecret

# DB
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_LOGGING=true
# Note: Disable caching while formatting the database. The commands won't finish if caching is enabled.
DATABASE_CACHING=false

# Cache
CACHE_TTL=0 #Forever
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_PASSWORD=

# Feature flags
RESIZE_BIG_IMAGES=false
CREATE_IMAGE_THUMBNAILS=false

# Email config
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
HOST_NAME=Notifications
SMTP_USER=
SMTP_PASS=
DEFAULT_FROM=

# AWS
AWS_KEY_ID=
AWS_KEY_SECRET=
AWS_REGION=
AWS_CDN=
AWS_S3_BUCKET_NAME=core
AWS_S3_BASE_PATH=uploads
AWS_S3_BUCKET_LOCATION=s3.amazonaws.com

# File upload
MAX_FILE_SIZE_IN_MB=50

# TWILIO
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SENDER=

# Firebase
FIREBASE_TYPE=
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=
FIREBASE_TOKEN_URI=
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=
FIREBASE_CLIENT_X509_CERT_URL=

# Social auth
# Apple
APPLE_AUD=
# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
