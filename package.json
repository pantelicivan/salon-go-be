{
  "name": "nestjs-core",
  "version": "0.0.1",
  "description": "A core project for quick development startup.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "predev": "rimraf dist",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_ENV=test jest --config ./test/jest-e2e.json --runInBand",
    "test:e2e:watch": "NODE_ENV=test jest --config ./test/jest-e2e.json --runInBand --watchAll",
    "typeorm": "typeorm-ts-node-commonjs",
    "db:migrate:create": "yarn run typeorm migration:create",
    "db:migrate:new": "yarn run typeorm migration:generate -d src/database/typeorm-cli.datasource.ts",
    "db:migrate": "yarn run typeorm migration:run -d src/database/typeorm-cli.datasource.ts",
    "db:migrate:rollback": "yarn run typeorm migration:revert -d src/database/typeorm-cli.datasource.ts",
    "db:schema:drop": "yarn run typeorm schema:drop -d src/database/typeorm-cli.datasource.ts",
    "db:seed:config": "ts-node ./node_modules/@concepta/typeorm-seeding/dist/cli.js config -c src/database/seeding.config.ts",
    "db:seed": "ts-node ./node_modules/@concepta/typeorm-seeding/dist/cli.js seed -c src/database/seeding.config.ts",
    "db:format": "yarn run db:schema:drop && yarn run db:migrate && yarn run db:seed",
    "db:cache:clear": "yarn run typeorm cache:clear -d src/database/typeorm-cli.datasource.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@keyv/redis": "^6.1.0",
    "@mapbox/node-pre-gyp": "^2.0.3",
    "@nestjs-modules/mailer": "^3.0.2",
    "@nestjs/cache-manager": "^12.0.1",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-formidable": "^1.2.0",
    "express-session": "^1.19.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.1",
    "handlebars": "^4.7.10",
    "keyv": "^6.1.0",
    "nest-winston": "^2.0.0",
    "nestjs-i18n": "^10.8.5",
    "nestjs-stripe": "^1.0.0",
    "nodemailer": "^10.1.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "snake-case": "^4.0.0",
    "stripe": "^23.0.0",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^6.2.0",
    "typeorm": "^1.1.2",
    "typeorm-transactional": "^0.5.0",
    "uuid": "^14.0.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@concepta/typeorm-seeding": "^4.0.0",
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/passport-facebook-token": "^0.4.40",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "test",
    "testRegex": "spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
